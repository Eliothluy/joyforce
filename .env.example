# Banco de dados (Postgres). Em produção use a string *pooled* do Neon,
# terminando em `?sslmode=require&pgbouncer=true`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/joyforce?schema=public"

# Segredo usado para assinar o cookie de sessão (mínimo 32 caracteres).
AUTH_SECRET="dev-apenas-troque-isto-em-producao-1234567890"
